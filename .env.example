# Application
NODE_ENV=development
PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Database (PostgreSQL)
POSTGRES_USER=gymflow_admin
POSTGRES_PASSWORD=gymflow_dev_password
POSTGRES_DB=gymflow
POSTGRES_PORT=5435

# Connection URLs
# For host/local development:
DATABASE_URL="postgresql://gymflow_admin:gymflow_dev_password@localhost:5435/gymflow?schema=public"
# For container-to-container networking (inside Docker):
# DATABASE_URL="postgresql://gymflow_admin:gymflow_dev_password@db:5432/gymflow?schema=public"

# Authentication
# Must be at least 32 characters in production
JWT_SECRET="development_jwt_secret_key_gymflow_min_32_chars"
